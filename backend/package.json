{
	"name": "backend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsx",
		"dev": "tsx --env-file=.env --watch src/main.ts",
		"start": "node ./bin/www",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"cookie-parser": "~1.4.7",
		"dotenv": "^18.0.7",
		"express": "~5.3.0",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"@types/swagger-ui-express": "^4.1.8",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
