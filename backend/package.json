{
	"name": "backend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsx --env-file=.env --watch src/main.ts",
		"start": "node --enable-source-maps build/main.js",
		"db:setup": "drizzle-kit generate && drizzle-kit migrate",
		"db:seed": "tsx --env-file=.env src/db/seed/index.ts",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"argon2": "^0.45.1",
		"cookie-parser": "~1.4.7",
		"dotenv": "^18.0.7",
		"drizzle-orm": "1.0.0-rc.4",
		"express": "~5.3.0",
		"jose": "^6.2.12",
		"lru-cache": "^11.5.3",
		"pg": "^8.23.1",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/swagger-ui-express": "^4.1.8",
		"drizzle-kit": "1.0.0-rc.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
